# Copy this file to .env (which is gitignored) and fill in your key.
# Get a key at https://physiology.presagetech.com  —  no quotes around the value.
#
# Dev:   loaded automatically via devcontainer.json runArgs ("--env-file").
# Robot: docker run --env-file /path/to/.env ...   (chmod 600, never bake into the image)
SMARTSPECTRA_API_KEY=sk_your_key_here
